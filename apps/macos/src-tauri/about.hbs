<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Mix third-party licenses</title>
  <style>body{font:15px system-ui,sans-serif;max-width:960px;margin:40px auto;padding:0 20px;color:#1f2933}h1{font-size:28px}h2{margin-top:32px}pre{white-space:pre-wrap;background:#f5f7f9;padding:16px;border-radius:6px}</style>
</head>
<body>
  <h1>Mix third-party licenses</h1>
  <p>License notices for the Rust dependencies distributed with Mix.</p>
  {{#each licenses}}
  <section>
    <h2>{{name}}</h2>
    <p>{{id}}</p>
    <pre>{{text}}</pre>
  </section>
  {{/each}}
</body>
</html>
