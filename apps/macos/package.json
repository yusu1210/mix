{
  "name": "mix-macos",
  "private": true,
  "version": "0.1.3",
  "description": "Shared React interface and Tauri shell for Mix",
  "license": "MIT",
  "engines": {
    "node": "24.18.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --port 1420",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "clean": "sh ../../scripts/clean.sh",
    "build:desktop": "sh scripts/build-desktop.sh",
    "bootstrap:rust": "sh scripts/bootstrap-rust.sh",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-clipboard-manager": "2.3.3",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "@tauri-apps/plugin-updater": "2.11.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "axe-core": "4.13.0",
    "jsdom": "30.0.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "4.1.11"
  }
}
